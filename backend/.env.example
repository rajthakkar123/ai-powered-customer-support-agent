# Copy values into your shell environment; never commit real credentials.
# The first start creates an administrator. Leave SUPPORT_ADMIN_PASSWORD empty to have the
# server generate one and print it once on the console (never in logs). Minimum 12 characters.
SUPPORT_ADMIN_EMAIL=admin@northstar.test
SUPPORT_ADMIN_PASSWORD=
SUPPORT_HOST=127.0.0.1
SUPPORT_PORT=8000
SUPPORT_AS_OF_DATE=2026-11-04
# "development" honours the X-Simulate-Tool-Failure header for demos; never set it in production.
SUPPORT_ENVIRONMENT=development
OPENAI_API_KEY=
